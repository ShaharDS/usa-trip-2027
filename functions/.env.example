# Copy to functions/.env (gitignored) before deploying.
# The site owner(s): always editors, the only ones who can change who has access and load data.
# One account, or several separated by commas (e.g. two Google accounts of the same person).
OWNER_EMAIL=you@gmail.com

# The Claude API key is NOT here — it is a secret:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
