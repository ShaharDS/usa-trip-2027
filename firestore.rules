rules_version = '2';

// Who can do what:
//   anyone          — read the route (trips/{t}/public/state: dates, stops, holidays — no prices), nothing else
//   family (listed) — also their own AI answers (users/{uid}/asks); asking goes through the aiAsk function,
//                     which gives the model the route only. Family never reads prices.
//   editors         — the plan with all prices, the private document, history, documents, proposals, usage
// Nobody writes trip data from the browser: every change goes through the Cloud Functions
// (commitChange, applyProposal, ...), which validate it, keep the history and regenerate the public route
// from the plan. The owner is configured in the functions (OWNER_EMAIL) and is always kept on the editors
// list in config/access.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function access() {
      return get(/databases/$(database)/documents/config/access).data;
    }
    function isEditor() {
      return signedIn() && email() in access().editors;
    }
    function isFamily() {
      return signedIn() && (email() in access().editors || email() in access().family);
    }

    match /trips/{tripId}/public/state {
      allow get: if true;
      allow list, write: if false;
    }

    match /trips/{tripId}/plan/state {
      allow get: if isEditor();
      allow list, write: if false;
    }

    match /trips/{tripId}/private/state {
      allow get: if isEditor();
      allow list, write: if false;
    }

    match /trips/{tripId}/changes/{id} {
      allow read: if isEditor();
      allow write: if false;
    }
    match /trips/{tripId}/documents/{id} {
      allow read: if isEditor();
      allow write: if false;
    }
    match /trips/{tripId}/alerts/{id} {
      allow read: if isEditor();
      allow write: if false;
    }
    match /trips/{tripId}/proposals/{id} {
      allow read: if isEditor();
      allow write: if false;
    }
    match /trips/{tripId}/usage/{id} {
      allow read: if isEditor();
      allow write: if false;
    }

    // The allowlist is managed only through the getAccess / setAccess functions.
    match /config/{doc} {
      allow read, write: if false;
    }

    // The earlier single-page trip site (repo root index.html) keeps its live price edits here:
    // public read, editors write {v, by, at}. Kept so that site keeps working while it is still in use.
    match /overrides/{docId} {
      allow read: if true;
      allow delete: if isEditor();
      allow create, update: if isEditor()
        && request.resource.data.keys().hasOnly(['v', 'by', 'at'])
        && request.resource.data.v is number
        && request.resource.data.v >= 0
        && request.resource.data.v <= 1000000
        && docId.size() <= 120;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && isFamily()
        && request.resource.data.keys().hasOnly(['lastSeenVersion', 'lastSeenAt'])
        && request.resource.data.lastSeenVersion is int
        && request.resource.data.lastSeenAt == request.time;
    }
    match /users/{uid}/asks/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
