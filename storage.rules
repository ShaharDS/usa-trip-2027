rules_version = '2';

// Tickets and booking confirmations: family can read, editors can upload. Never public.
// Files are read with getBlob() through these rules — the app never creates public download links.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function access() {
      return firestore.get(/databases/(default)/documents/config/access).data;
    }
    function isEditor() {
      return signedIn() && email() in access().editors;
    }
    function isFamily() {
      return signedIn() && (email() in access().editors || email() in access().family);
    }
    function okType() {
      return (request.resource.contentType == 'application/pdf' && request.resource.size < 20 * 1024 * 1024)
        || (request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size < 10 * 1024 * 1024);
    }

    match /trips/{tripId}/docs/{docId}/{fileName} {
      allow read: if isFamily();
      allow create: if resource == null && isEditor() && okType()
        && docId.matches('[A-Za-z0-9_-]{1,40}')
        && fileName.matches('[A-Za-z0-9._-]{1,100}');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
