rules_version = '2';

// Tickets and booking confirmations live in Storage, but the browser never reads or writes it: the
// addDocument / getDocumentFile Cloud Functions do, after checking that the caller is an editor (they show
// prices). So these rules deny everything — no cross-service Firestore lookup, IAM role or bucket CORS needed.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
